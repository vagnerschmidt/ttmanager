{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/sync/(.*)", "destination": "/api/sync" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/vercel-sync",
      "schedule": "0 */1 * * *"
    }
  ]
}
